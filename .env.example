# Copy to .env for local development outside Docker. Never commit a real .env.
DATABASE_URL=postgresql+psycopg://lendflow:lendflow@localhost:5432/lendflow

# Signs access tokens. Required, at least 32 characters; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-development-only-secret-change-me

# Used by the test suite; it must point at a disposable database.
TEST_DATABASE_URL=postgresql+psycopg://lendflow:lendflow@localhost:5432/lendflow_test
